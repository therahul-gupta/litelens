{
  "name": "litelens",
  "version": "1.0.0",
  "description": "⚡ Lightning-fast, zero-config web studio for SQLite databases",
  "type": "module",
  "bin": {
    "litelens": "./bin/litelens.js"
  },
  "main": "./dist/server/cli.js",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsup src/server/cli.ts --format esm --out-dir dist/server --external better-sqlite3",
    "build": "npm run build:client && npm run build:server",
    "test": "tsx --test tests/api.test.ts",
    "start": "node bin/litelens.js"
  },
  "keywords": [
    "sqlite",
    "database",
    "sql",
    "viewer",
    "studio",
    "gui",
    "duckdb",
    "browser",
    "developer-tools"
  ],
  "author": "Rahul Gupta",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "lucide-react": "^1.70.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
